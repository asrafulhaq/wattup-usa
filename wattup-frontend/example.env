# ── Cloudinary ────────────────────────────────────────────────────────────────
# Server-only. lib/cloudinary.ts reads these to sign uploads; none of them is
# NEXT_PUBLIC_ and none may become so (finding F12).
CLOUDINARY_CLOUD_NAME=''
CLOUDINARY_API_KEY=''
CLOUDINARY_API_SECRET=''
CLOUDINARY_URL=''
# The public cloud name the browser uses to build delivery URLs (lib/images/).
# It appears in every image URL anyway, so exposing it is fine. The API key
# is never NEXT_PUBLIC_.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=''

DATABASE_URL=""

# ── Better Auth ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=''
BETTER_AUTH_URL='http://localhost:3000'
NEXT_PUBLIC_APP_URL='http://localhost:3000'

# ── Admin Seed Credentials ────────────────────────────────────────────────────
ADMIN_EMAIL='admin@wattup.com'
ADMIN_PASSWORD='password123'
ADMIN_NAME='WattUp Admin'
# Additional super admins, comma separated. `pnpm seed:admins` creates or promotes
# each one; new accounts are created with ADMIN_PASSWORD.
ADMIN_EMAILS=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=''
MAIL_FROM='WattUp <noreply@wattup.com>'
CONTACT_EMAIL=''

NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=''
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=''
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=''

# ── Cookie consent (CMP) — set exactly ONE; CookieYes wins if both are set ──
# CookieYes site ID (from the script URL in app.cookieyes.com) — the default
NEXT_PUBLIC_COOKIEYES_ID=''
# Cookiebot Domain Group ID (from admin.cookiebot.com) — alternative vendor
NEXT_PUBLIC_COOKIEBOT_CBID=''
