generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  COLLABORATOR
}

// Build state of a charging site. A driver reads this as "can I charge here today",
// so it is kept separate from goLiveYear, which is a project milestone.
enum StationStatus {
  LIVE
  UNDER_CONSTRUCTION
  PLANNED
}

enum ConnectorType {
  CCS1
  NACS
  CCS2
  CHAdeMO
}

// Permission enum is used for type-safe RBAC in application code.
// Role → Permission mapping is defined in lib/permissions.ts.
enum Permission {
  // Post management
  CREATE_POST
  EDIT_ANY_POST
  EDIT_OWN_POST
  DELETE_ANY_POST
  DELETE_OWN_POST
  PUBLISH_POST

  // Site management
  MANAGE_SITE_SETTINGS
  MANAGE_SOCIAL_LINKS

  // User management
  VIEW_USERS
  INVITE_USERS
  EDIT_USERS
  CHANGE_USER_ROLE
  DELETE_USERS
  BAN_USERS

  // Charging network
  MANAGE_LOCATIONS
  DELETE_LOCATIONS
  MANAGE_AMENITIES
}

// ─── Better Auth Core Models ──────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  bio           String?  @default("")
  imagePublicId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  role Role @default(COLLABORATOR)

  // Better Auth admin plugin fields
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  sessions Session[]
  accounts Account[]

  // Pro-forma app (wattup-proforma). Its sessions are never dashboard sessions.
  proformaSessions ProformaSession[]
  proformaAccounts ProformaAccount[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  // admin plugin
  impersonatedBy String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  // Better Auth ≥ 1.7 supplies an issuer on every account (synthetic for credential
  // and OAuth providers without one). Nullable so rows created before the upgrade
  // keep loading; Better Auth fills it on every insert. Finding F15.
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  @@unique([issuer, accountId])

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ─── Pro-forma app (wattup-proforma) ──────────────────────────────────────────
//
// Owned HERE, used THERE. wattup-proforma maps Better Auth's default model names
// (Session, Account, Verification) onto these tables, so a session minted by a
// six digit code on hostproposal.wattupusa.com is structurally not a dashboard
// session. See docs/adr/0001-proforma-access-architecture.md section 6.
//
// wattup-proforma never migrates. If a column here changes, change
// wattup-proforma/prisma/schema.prisma in the same PR, or its client drifts.

model ProformaSession {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("proforma_session")
}

/// Required by Better Auth's core schema. The pro-forma app has no password and no
/// OAuth provider, so no rows are expected in practice.
model ProformaAccount {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  // Better Auth ≥ 1.7 supplies an issuer on every account (synthetic for credential
  // and OAuth providers without one). Nullable so rows created before the upgrade
  // keep loading; Better Auth fills it on every insert. Finding F15.
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@unique([issuer, accountId])
  @@map("proforma_account")
}

/// One-time codes live here, hashed (storeOTP: 'hashed' in the pro-forma app).
model ProformaVerification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("proforma_verification")
}

model Profile {
  id        String   @id @default(uuid())
  name      String   @default("")
  bio       String   @default("")
  image     Json?
  about     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([id])
}

model SocialLink {
  id        String   @id @default(uuid())
  userId    String
  name      String   @default("")
  url       String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Posts {
  id            String    @id @default(uuid())
  title         String
  slug          String?   @unique @default("")
  content       String?   @default("")
  image         String?   @default("")
  imageAlt      String?   @default("")
  author        String?   @default("")
  authorUrl     String?   @default("")
  featured      Boolean   @default(false)
  featuredImage Json?
  status        String    @default("Draft")
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([id])
  @@index([slug])
  @@index([status])
  @@index([publishedAt])
}

model SiteSettings {
  id String @id @default("singleton")

  // Google Tracking
  googleAnalyticsId      String?
  googleTagManagerId     String?
  googleSiteVerification String?

  // Meta / Facebook
  metaPixelId String?

  // Custom Script Injection (raw HTML)
  headScripts      String?
  bodyStartScripts String?
  bodyEndScripts   String?

  // AEO / Organization Schema
  orgName        String?
  orgDescription String?
  orgUrl         String?
  orgPhone       String?
  orgEmail       String?
  orgAddress     String?
  orgLogoUrl     String?
  orgTwitter     String?
  orgLinkedin    String?
  orgFacebook    String?
  orgInstagram   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ─── Charging network ─────────────────────────────────────────────────────────

/// A signed charging site.
///
/// Holds every column of the signed-locations sheet. The lower block is private:
/// `company`, `noticeAddress` (several are residential), `apn`, `siteScore`, `salesRep`
/// and the deal notes. lib/locations/public.ts is the single place that decides what
/// leaves the server, and it is the only thing that may widen this.
model Location {
  id   String @id @default(cuid())
  slug String @unique

  // ── Public ────────────────────────────────────────────────────────────────
  name         String
  street       String
  city         String
  /// State for US sites, region elsewhere.
  region       String
  postalCode   String
  /// ISO-3166 alpha-2.
  country      String        @default("US")
  latitude     Float
  longitude    Float
  /// Market registry key, so Singapore is rows rather than a refactor.
  market       String        @default("us-ca")
  status       StationStatus @default(PLANNED)
  /// Funded install year. Int rather than an enum: the dashboard may set 2028.
  goLiveYear   Int
  county       String        @default("")
  countyFips   String        @default("")
  /// Peak charging speed in kW. 310 across the network, per the client's spec.
  maxPowerKw   Int           @default(310)
  chargerCount Int           @default(0)
  /// USD per kWh before tax. Decimal, not Float: a tariff is money.
  /// Null until a tariff is set, which reads as "Being confirmed" on the site.
  pricePerKwh  Decimal?      @db.Decimal(8, 4)

  /// Hides the site from the public finder without deleting the record.
  published Boolean @default(true)

  // ── Search and social ─────────────────────────────────────────────────────
  /// Overrides the generated <title>. Blank falls back to the generated one, which is
  /// usually better: it is built from the address and stays correct when that changes.
  metaTitle       String?
  /// Overrides the generated meta description. Same fallback rule.
  metaDescription String?
  /// Photograph of the site. Used as the social share image and as schema.org `image`.
  imageUrl        String?
  /// Cloudinary public id for imageUrl, so a replaced image can be cleaned up.
  imagePublicId   String?
  /// Keeps the page out of search results while leaving it reachable by link.
  noIndex         Boolean @default(false)

  // ── Private. Never projected to the browser. ──────────────────────────────
  signedNumber          Int?
  initialNotes          String  @default("")
  pipelineRef           String  @default("")
  /// Property owner's legal entity.
  company               String  @default("")
  /// The address exactly as the sheet writes it, before parsing.
  addressRaw            String  @default("")
  /// Owner's address for legal notices. Often a home.
  noticeAddress         String  @default("")
  /// Assessor's parcel number.
  apn                   String  @default("")
  /// Internal site score out of 5. Not a customer review.
  siteScore             Float?
  switchgearCount       Int?
  switchgearOrderedDate String?
  salesRep              String  @default("")

  amenities  LocationAmenity[]
  connectors LocationConnector[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, status])
  @@index([published, noIndex])
  @@index([city])
  @@index([goLiveYear])
  @@map("location")
}

/// The amenity catalogue, seeded whole so every option exists before anyone opens
/// the dashboard. `icon` is a registry key resolved in lib/locations/amenities.ts:
/// a React component cannot be stored in a column.
model Amenity {
  id    String @id @default(cuid())
  /// Stable key used in URLs and filter state. Not the display label.
  slug  String @unique
  label String
  icon  String @default("dot")

  sortOrder Int     @default(0)
  /// Turns the amenity off across the whole network without unassigning it
  /// from any site, so switching it back on restores what was there.
  active    Boolean @default(true)

  locations LocationAmenity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
  @@map("amenity")
}

model LocationAmenity {
  locationId String
  amenityId  String

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([locationId, amenityId])
  @@index([amenityId])
  @@map("location_amenity")
}

/// Connector types and counts for one site. A row per type rather than JSON, so
/// "how many NACS across the network" stays a query.
model LocationConnector {
  id         String        @id @default(cuid())
  locationId String
  type       ConnectorType
  count      Int           @default(0)

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, type])
  @@map("location_connector")
}
