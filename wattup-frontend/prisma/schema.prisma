generator client {
  provider        = "prisma-client-js"
  // "views" is what lets ProformaMember at the bottom be declared as a view. Prisma
  // never migrates a view; the SQL lives in the migration that creates it.
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

// Ranks live in lib/permissions.ts (ROLE_RANK). COLLABORATOR was removed by the
// rbac_permissions migration, which refuses to run while any user still holds it.
// A new role is added here, ranked there, and seeded into role_permission by migration.
enum Role {
  SUPER_ADMIN
  ADMIN
  NETWORK_MANAGER
  EDITOR
  SALES
}

// Build state of a charging site. A driver reads this as "can I charge here today",
// so it is kept separate from goLiveYear, which is a project milestone.
enum StationStatus {
  LIVE
  UNDER_CONSTRUCTION
  PLANNED
}

enum ConnectorType {
  CCS1
  NACS
  CCS2
  CHAdeMO
}

// The registry of permission names. What each ROLE holds by default is a row in
// role_permission (seeded by migration from lib/permissions.ts ROLE_PERMISSIONS);
// what each USER holds on top is a row in user_permission. Resolution is in
// lib/permissions-server.ts. No column stores a Permission on its own.
enum Permission {
  // Content
  CREATE_POST
  EDIT_ANY_POST
  EDIT_OWN_POST
  DELETE_ANY_POST
  DELETE_OWN_POST
  PUBLISH_POST

  // Charging network
  VIEW_LOCATIONS
  MANAGE_LOCATIONS
  DELETE_LOCATIONS
  MANAGE_AMENITIES

  // User management
  VIEW_USERS
  INVITE_USERS
  EDIT_USERS
  CHANGE_USER_ROLE
  DELETE_USERS
  BAN_USERS
  MANAGE_PERMISSIONS

  // Site management
  MANAGE_SITE_SETTINGS
  MANAGE_SOCIAL_LINKS

  // Media
  UPLOAD_MEDIA
  DELETE_MEDIA

  // Audit
  VIEW_ACTIVITY_LOG

  // Pro-forma builder (wattup-proforma reads this through the proforma_member view)
  ACCESS_PROFORMA

  // Reserved. These four exist only because the database already has them: the
  // 20260518 migration created them and they were never carried into this file
  // (checklist 4a.41). Nothing checks them. Kept so the schema and the database
  // agree; Postgres cannot drop an enum value without recreating the type.
  DELETE_ANY_MEDIA
  DELETE_OWN_MEDIA
  MANAGE_PROFILE
  VIEW_ANALYTICS
}

// ─── Better Auth Core Models ──────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  bio           String?  @default("")
  imagePublicId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // No default on purpose (checklist 4a.26): every remaining role is a real working
  // role, so an insert that forgets the role fails loudly instead of granting one.
  role Role

  // Better Auth admin plugin fields
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  sessions Session[]
  accounts Account[]

  // Pro-forma app (wattup-proforma). Its sessions are never dashboard sessions.
  proformaSessions ProformaSession[]
  proformaAccounts ProformaAccount[]

  // RBAC and audit
  permissions        UserPermission[] @relation("UserPermissionSubject")
  grantedPermissions UserPermission[] @relation("UserPermissionGrantor")
  activityAsSubject  ActivityLog[]    @relation("ActivityLogSubject")
  activityAsActor    ActivityLog[]    @relation("ActivityLogActor")

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  // admin plugin
  impersonatedBy String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  // Better Auth ≥ 1.7 supplies an issuer on every account (synthetic for credential
  // and OAuth providers without one). Nullable so rows created before the upgrade
  // keep loading; Better Auth fills it on every insert. Finding F15.
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ─── Pro-forma app (wattup-proforma) ──────────────────────────────────────────
//
// Owned HERE, used THERE. wattup-proforma maps Better Auth's default model names
// (Session, Account, Verification) onto these tables, so a session minted by a
// six digit code on hostproposal.wattupusa.com is structurally not a dashboard
// session. See docs/adr/0001-proforma-access-architecture.md section 6.
//
// wattup-proforma never migrates. If a column here changes, change
// wattup-proforma/prisma/schema.prisma in the same PR, or its client drifts.

model ProformaSession {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("proforma_session")
}

/// Required by Better Auth's core schema. The pro-forma app has no password and no
/// OAuth provider, so no rows are expected in practice.
model ProformaAccount {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  // Better Auth ≥ 1.7 supplies an issuer on every account (synthetic for credential
  // and OAuth providers without one). Nullable so rows created before the upgrade
  // keep loading; Better Auth fills it on every insert. Finding F15.
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("proforma_account")
}

/// One-time codes live here, hashed (storeOTP: 'hashed' in the pro-forma app).
model ProformaVerification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("proforma_verification")
}

/// The pro-forma gate's rate-limit counters (ADR 0001 section 10, checklist 5.1 to
/// 5.7): one row per key, a fixed window of `count` hits from `windowStart`, and
/// `lastHit` for the 60 second gap between sends. `key` is `kind:` plus an HMAC of
/// the address or IP under the pro-forma app's secret, never the raw value, so the
/// table identifies nobody. wattup-proforma reads and writes it with one raw upsert
/// and sweeps rows older than every window; nothing in this app touches it.
model ProformaRateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
  lastHit     DateTime

  @@map("proforma_rate_limit")
}

// ─── RBAC ─────────────────────────────────────────────────────────────────────
//
// Role is a template; the authority is the resolved set (ADR 0002 section 3):
// role defaults from role_permission, minus user_permission rows with granted = false
// (never for SUPER_ADMIN), plus rows with granted = true. lib/permissions-server.ts
// resolves it once per request. wattup-proforma reads the same answer for
// ACCESS_PROFORMA through the proforma_member view at the bottom of this file.

/// What a role holds by default. Seeded by migration from ADR 0002 section 6;
/// editable by whoever holds MANAGE_PERMISSIONS.
model RolePermission {
  id         String     @id @default(cuid())
  role       Role
  permission Permission

  @@unique([role, permission])
  @@map("role_permission")
}

/// A per-user override on top of the role. granted = true adds the permission,
/// granted = false removes it. One row per (user, permission); a second change to the
/// same pair updates the row rather than stacking.
model UserPermission {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation("UserPermissionSubject", fields: [userId], references: [id], onDelete: Cascade)
  permission  Permission
  granted     Boolean
  /// Who made the change. Null once that account is deleted; the activity_log row keeps
  /// the email.
  grantedById String?
  grantedBy   User?      @relation("UserPermissionGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@unique([userId, permission])
  @@index([userId])
  @@map("user_permission")
}

// ─── Audit ────────────────────────────────────────────────────────────────────

/// One row per auditable event, written by both apps (ADR 0001 section 9, D7).
///
/// `email` and `userId` name the SUBJECT of the event: the user who was changed, or
/// the address that asked for a code. `actorEmail` and `actorUserId` name who did it,
/// and are null for the pro-forma app's self-service events. The email is stored in
/// full on purpose: the dashboard page that reads this has to be readable (checklist
/// 4b.7). Application logs mask it; only this table carries it whole.
///
/// `userId` and `actorUserId` are SetNull so deleting an account keeps its history.
/// `app` is 'dashboard' or 'proforma'. `event` is dot namespaced: the dashboard writes
/// permission.granted, permission.revoked, role.changed, user.banned, user.unbanned,
/// user.created and user.deleted; the pro-forma app writes code.requested,
/// code.refused, signin.success and signin.failed.
model ActivityLog {
  id            String   @id @default(cuid())
  app           String
  event         String
  email         String
  userId        String?
  user          User?    @relation("ActivityLogSubject", fields: [userId], references: [id], onDelete: SetNull)
  actorUserId   String?
  actor         User?    @relation("ActivityLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail    String?
  ipAddress     String?
  userAgent     String?
  correlationId String?
  meta          Json?
  createdAt     DateTime @default(now())

  @@index([app, createdAt])
  @@index([email, createdAt])
  @@index([userId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("activity_log")
}

model Profile {
  id        String   @id @default(uuid())
  name      String   @default("")
  bio       String   @default("")
  image     Json?
  about     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([id])
}

model SocialLink {
  id        String   @id @default(uuid())
  userId    String
  name      String   @default("")
  url       String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Posts {
  id            String    @id @default(uuid())
  title         String
  slug          String?   @unique @default("")
  content       String?   @default("")
  image         String?   @default("")
  imageAlt      String?   @default("")
  author        String?   @default("")
  authorUrl     String?   @default("")
  featured      Boolean   @default(false)
  featuredImage Json?
  status        String    @default("Draft")
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([id])
  @@index([slug])
  @@index([status])
  @@index([publishedAt])
}

model SiteSettings {
  id String @id @default("singleton")

  // Google Tracking
  googleAnalyticsId      String?
  googleTagManagerId     String?
  googleSiteVerification String?

  // Meta / Facebook
  metaPixelId String?

  // Custom Script Injection (raw HTML)
  headScripts      String?
  bodyStartScripts String?
  bodyEndScripts   String?

  // AEO / Organization Schema
  orgName        String?
  orgDescription String?
  orgUrl         String?
  orgPhone       String?
  orgEmail       String?
  orgAddress     String?
  orgLogoUrl     String?
  orgTwitter     String?
  orgLinkedin    String?
  orgFacebook    String?
  orgInstagram   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ─── Charging network ─────────────────────────────────────────────────────────

/// A signed charging site.
///
/// Holds every column of the signed-locations sheet. The lower block is private:
/// `company`, `noticeAddress` (several are residential), `apn`, `siteScore`, `salesRep`
/// and the deal notes. lib/locations/public.ts is the single place that decides what
/// leaves the server, and it is the only thing that may widen this.
model Location {
  id   String @id @default(cuid())
  slug String @unique

  // ── Public ────────────────────────────────────────────────────────────────
  name         String
  street       String
  city         String
  /// State for US sites, region elsewhere.
  region       String
  postalCode   String
  /// ISO-3166 alpha-2.
  country      String        @default("US")
  latitude     Float
  longitude    Float
  /// Market registry key, so Singapore is rows rather than a refactor.
  market       String        @default("us-ca")
  status       StationStatus @default(PLANNED)
  /// Funded install year. Int rather than an enum: the dashboard may set 2028.
  goLiveYear   Int
  county       String        @default("")
  countyFips   String        @default("")
  /// Peak charging speed in kW. 310 across the network, per the client's spec.
  maxPowerKw   Int           @default(310)
  chargerCount Int           @default(0)
  /// USD per kWh before tax. Decimal, not Float: a tariff is money.
  /// Null until a tariff is set, which reads as "Being confirmed" on the site.
  pricePerKwh  Decimal?      @db.Decimal(8, 4)

  /// Hides the site from the public finder without deleting the record.
  published Boolean @default(true)

  // ── Search and social ─────────────────────────────────────────────────────
  /// Overrides the generated <title>. Blank falls back to the generated one, which is
  /// usually better: it is built from the address and stays correct when that changes.
  metaTitle       String?
  /// Overrides the generated meta description. Same fallback rule.
  metaDescription String?
  /// Photograph of the site. Used as the social share image and as schema.org `image`.
  imageUrl        String?
  /// Cloudinary public id for imageUrl, so a replaced image can be cleaned up.
  imagePublicId   String?
  /// Keeps the page out of search results while leaving it reachable by link.
  noIndex         Boolean @default(false)

  // ── Private. Never projected to the browser. ──────────────────────────────
  signedNumber          Int?
  initialNotes          String  @default("")
  pipelineRef           String  @default("")
  /// Property owner's legal entity.
  company               String  @default("")
  /// The address exactly as the sheet writes it, before parsing.
  addressRaw            String  @default("")
  /// Owner's address for legal notices. Often a home.
  noticeAddress         String  @default("")
  /// Assessor's parcel number.
  apn                   String  @default("")
  /// Internal site score out of 5. Not a customer review.
  siteScore             Float?
  switchgearCount       Int?
  switchgearOrderedDate String?
  salesRep              String  @default("")

  amenities  LocationAmenity[]
  connectors LocationConnector[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, status])
  @@index([published, noIndex])
  @@index([city])
  @@index([goLiveYear])
  @@map("location")
}

/// The amenity catalogue, seeded whole so every option exists before anyone opens
/// the dashboard. `icon` is a registry key resolved in lib/locations/amenities.ts:
/// a React component cannot be stored in a column.
model Amenity {
  id    String @id @default(cuid())
  /// Stable key used in URLs and filter state. Not the display label.
  slug  String @unique
  label String
  icon  String @default("dot")

  sortOrder Int     @default(0)
  /// Turns the amenity off across the whole network without unassigning it
  /// from any site, so switching it back on restores what was there.
  active    Boolean @default(true)

  locations LocationAmenity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
  @@map("amenity")
}

model LocationAmenity {
  locationId String
  amenityId  String

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([locationId, amenityId])
  @@index([amenityId])
  @@map("location_amenity")
}

/// Connector types and counts for one site. A row per type rather than JSON, so
/// "how many NACS across the network" stays a query.
model LocationConnector {
  id         String        @id @default(cuid())
  locationId String
  type       ConnectorType
  count      Int           @default(0)

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, type])
  @@map("location_connector")
}

// ─── Views ────────────────────────────────────────────────────────────────────

/// Who may sign in to the pro-forma builder, resolved in SQL (ADR 0001 section 18):
/// every user who is not banned and holds ACCESS_PROFORMA, whether from their role or
/// from a user_permission grant, and not stripped of it by a revoke (a revoke never
/// applies to SUPER_ADMIN). `email` is lowercased so the pro-forma app's exact match
/// against a normalised address works. The password is not selected.
///
/// Created by the rbac_permissions migration, never by Prisma. wattup-proforma
/// declares the same four columns as a plain model and only ever SELECTs from it;
/// nothing in this app reads it. Change the columns in both schemas together.
/// (`id` is @unique rather than @id: Prisma refuses a primary key on a view.)
view ProformaMember {
  id     String  @unique
  email  String  @unique
  name   String
  active Boolean

  @@map("proforma_member")
}

// ─── Better Auth rate limiter ─────────────────────────────────────────────────

/// Counters for Better Auth's request rate limiter, read and written by the library
/// itself because `rateLimit.storage` is `'database'` in lib/auth.ts (finding F9,
/// checklist B.10 and S.4.6). `rateLimit.modelName` there names this model's Prisma
/// delegate, `prisma.rateLimit`; the SQL table name comes from @@map. One row per
/// `ip|path` key: `count` hits since the window last reset and `lastRequest` the time
/// of the latest one, in milliseconds since the epoch, hence BigInt. A key whose
/// `lastRequest` is older than its rule's window starts over, and the library prunes
/// rows older than the longest window on each reset. The columns are the three Better
/// Auth declares for the table (key, count, lastRequest) plus `id`, which its Prisma
/// adapter reads back on every guarded increment; the default is Prisma's because
/// lib/auth.ts sets generateId: false. Named parallel to proforma_rate_limit above,
/// which belongs to the pro-forma app's own limiter and is unrelated.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("auth_rate_limit")
}
