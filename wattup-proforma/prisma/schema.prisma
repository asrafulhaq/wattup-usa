// wattup-proforma — a deliberately narrow, read-mostly schema.
//
// wattup-frontend OWNS the database schema and is the only app that migrates it.
// This file mirrors just the tables this app touches. It must never be the source
// of a migration: there is no `migrate` or `db push` script in package.json, and
// prisma.config.ts declares no migrations path. See ADR 0001 section 5.
//
// Model names are Better Auth's defaults so its Prisma adapter finds them; the
// @@map directives point them at this app's own tables, so a session minted here
// is not a dashboard session. See ADR 0001 section 6.
//
// This mirror omits the owner's @@index declarations on purpose: it never migrates,
// so a `migrate diff` run from this app is not drift, and indexes are the owner's.
// ActivityLog is the one exception: it is the one table BOTH apps write, so its
// indexes are declared here verbatim from the owner to keep the two declarations
// comparable by eye. They are still the owner's, and still never migrated from here.
//
// Session, Account and Verification carry `@default(cuid())` on `id`. lib/auth.ts
// runs Better Auth with `generateId: false`, so Better Auth sends no id on insert
// and expects the data layer to supply one. Prisma's cuid() is generated by the
// CLIENT, never the database: the column stays TEXT NOT NULL with no DB default,
// exactly as wattup-frontend migrated it, so this is not a schema change and
// implies no migration. Without it every insert fails. Checklist 2.0a.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// SHARED with wattup-frontend. Read only from this app.
///
/// Deliberately narrow: `role` and `bio` are omitted so this app does not have to
/// declare the Role enum and cannot drift from it. Nothing here ever writes to
/// this table — Better Auth runs with disableSignUp, so no user is created.
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  banned        Boolean?
  createdAt     DateTime
  updatedAt     DateTime

  sessions Session[]
  accounts Account[]

  @@map("user")
}

/// This app's own sessions. NOT the dashboard's `session` table.
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("proforma_session")
}

/// Required by Better Auth's core schema. Unused in practice: this app has no
/// password and no OAuth provider, so no rows are expected.
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  // Better Auth ≥ 1.7 supplies an issuer on every account (synthetic for credential
  // and OAuth providers without one). Nullable so rows created before the upgrade
  // keep loading; Better Auth fills it on every insert. Finding F15.
  issuer                String?
  createdAt             DateTime
  updatedAt             DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([issuer, accountId])

  @@map("proforma_account")
}

/// Where the one-time codes live, hashed. Better Auth writes and reads this.
model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("proforma_verification")
}

/// The gate's rate-limit counters (lib/rate-limit.ts): one row per hashed key, a
/// fixed window of `count` hits from `windowStart`, and `lastHit` for the gap between
/// sends. Read AND written from this app, through one raw upsert so the window reset
/// and the increment are a single statement. Declared by wattup-frontend, which is
/// the app that applies the migration.
///
/// NOT YET APPLIED. Until the 20260902200000_proforma_rate_limit migration has run,
/// every query against it fails and the limiter carries on in memory (ADR 0001
/// section 10: the limiter fails open). Mirrored here so `prisma validate` and the
/// generated client know the shape; the raw SQL names the table directly.
model ProformaRateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
  lastHit     DateTime

  @@map("proforma_rate_limit")
}

/// The `proforma_member` SQL VIEW that wattup-frontend owns (ADR 0001 section 18):
/// one row per user who currently holds ACCESS_PROFORMA and is not banned. It is
/// the single definition of who may sign in here, resolved in SQL so this app never
/// duplicates permission logic. Read only: this app only ever SELECTs from it, and
/// never migrates it. Declared as a plain model rather than a `view` so no preview
/// feature is needed; Prisma does not care at query time.
///
/// NOT YET CREATED. The view arrives with the phase 4b migration (checklist 4b.2).
/// Until then every query against it fails at runtime, and lib/member-directory.ts
/// treats that failure as "no member".
model ProformaMember {
  id     String  @id
  email  String  @unique
  name   String
  active Boolean

  @@map("proforma_member")
}

/// The audit log (ADR 0001 section 9), SHARED with wattup-frontend, which owns the
/// table, migrates it, and renders it in the dashboard. This app only ever INSERTs,
/// through lib/activity-log.ts, and only from inside after(): `code.requested`,
/// `code.refused`, `signin.success` and `signin.failed`, each with the client's IP,
/// user agent and the request's correlation id. `app` is always 'proforma' here.
///
/// `email` is the FULL address, on purpose: the dashboard must be able to show a
/// person's history (ADR section 9 resolves the PRD's contradiction that way).
/// Application logs mask it; this table does not. `actorUserId` and `actorEmail`
/// are the dashboard's, for events one user performs on another, and stay null here.
///
/// No relation to User: a narrow mirror declares no foreign keys, and a row must
/// outlive the user it names. Declared as a plain model; Prisma does not care.
///
/// NOT YET CREATED. The table arrives with the wattup-frontend phase 4b migration
/// (checklist 4b.1). Until then every insert fails with Prisma's P2021, which
/// lib/activity-log.ts reports once per process and otherwise swallows: an audit
/// row that cannot be written is never a reason to change or delay a response.
model ActivityLog {
  id            String   @id @default(cuid())
  app           String
  event         String
  email         String
  userId        String?
  actorUserId   String?
  actorEmail    String?
  ipAddress     String?
  userAgent     String?
  correlationId String?
  meta          Json?
  createdAt     DateTime @default(now())

  @@index([app, createdAt])
  @@index([email, createdAt])
  @@index([userId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("activity_log")
}
