# wattup-proforma — local development.
# Secrets here are PER APP. BETTER_AUTH_SECRET must differ from the dashboard's,
# so rotating this app's sessions does not sign out wattupusa.com users.

# Shared Postgres, pooled endpoint. wattup-frontend owns the schema; this app
# never migrates it.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

BETTER_AUTH_SECRET=generate with: openssl rand -hex 32
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Resend. A separate key from the dashboard's, so it can be revoked alone.
RESEND_API_KEY=
MAIL_FROM=WattUp <proposals@send.wattupusa.com>
MAIL_REPLY_TO=

# Phase 1 member source. Comma separated. NEVER set this in production:
# it bypasses the database membership check.
PROFORMA_ALLOWLIST=

SESSION_TTL_DAYS=7
OTP_TTL_SECONDS=600
