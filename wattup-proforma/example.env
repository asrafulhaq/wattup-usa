# wattup-proforma — local development.
# Secrets here are PER APP. BETTER_AUTH_SECRET must differ from the dashboard's,
# so rotating this app's sessions does not sign out wattupusa.com users.

# Shared Postgres, pooled endpoint. wattup-frontend owns the schema; this app
# never migrates it.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

BETTER_AUTH_SECRET=generate with: openssl rand -hex 32
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Resend. Same key and sender as wattup-frontend, by client decision (2 Sep 2026).
RESEND_API_KEY=
MAIL_FROM=WattUp <noreply@wattupusa.com>
MAIL_REPLY_TO=

# Development member source, honoured OUTSIDE production only. Comma separated.
# In production it is IGNORED even when set (a warning is logged once) and
# membership always comes from the proforma_member view, so an env list can
# never bypass a revocation made in the dashboard (checklist 4b.4). Leave it
# unset there.
PROFORMA_ALLOWLIST=

SESSION_TTL_DAYS=7
OTP_TTL_SECONDS=600

# Optional. Extra hostnames /api/tool/evpin-fetch may fetch a report from, comma
# separated, on top of the built-in evpin.com and its subdomains. Absence is the
# normal case, so it is NOT in lib/env.ts's required list, which is a fail-closed 503.
EVPIN_ALLOWED_HOSTS=''
